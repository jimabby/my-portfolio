# Google Gemini API key for the portfolio AI assistant.
# Used by the Vite dev middleware (vite.config.js) and the Vercel function (api/chat.js).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: comma-separated origins allowed to call /api/chat in addition to the
# site's own origin (same-origin requests are always allowed). Use this to permit
# Vercel preview URLs, e.g. https://my-portfolio-git-foo.vercel.app
ALLOWED_ORIGINS=

# Optional: Upstash Redis for durable, cross-instance rate limiting on /api/chat.
# When unset, the endpoint falls back to best-effort in-memory limiting.
# Create a free database at https://console.upstash.com/redis and copy the
# REST URL + token from its "REST API" section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# EmailJS credentials used only by the server-side /api/contact endpoint.
# Restrict the EmailJS template and account to your production domains.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional when EmailJS private-key authentication is enabled.
EMAILJS_PRIVATE_KEY=

# Read the collected feedback back with `npm run feedback` (it reads this same
# file). See README.
#
# The Upstash pair above also backs /api/feedback, which records whether an
# assistant reply was useful along with the question that was asked. No IP or
# visitor identifier is stored. Without Upstash the vote is accepted and
# dropped, so the button never looks broken.
