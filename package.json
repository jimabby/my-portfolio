{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router": "^8.3.1",
    "swiper": "^12.2.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run images && npm run facts",
    "build": "vite build && node scripts/generate-route-html.mjs && node scripts/generate-service-worker.mjs",
    "prebuild": "npm run images && npm run facts && npm run csp",
    "csp": "node scripts/generate-csp.mjs",
    "images": "node scripts/generate-responsive-images.mjs && node scripts/generate-og-images.mjs",
    "facts": "node scripts/generate-project-facts.mjs",
    "og": "node scripts/generate-og-images.mjs",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "icons": "node scripts/generate-icon-css.mjs",
    "icons:app": "node scripts/generate-app-icons.mjs",
    "fonts": "node scripts/generate-fonts.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "feedback": "node scripts/read-feedback.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.4",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
